// ============================================================================
// PRISMA SCHEMA - Controle de Estoque Laboratório de Imunoistoquímica (IHQ)
// Nota: Compatível com PostgreSQL / MySQL / SQLite.
// Para usar PostgreSQL em produção, altere provider = "postgresql" no bloco db.
// ============================================================================

datasource db {
  provider = "sqlite" // Altere para "postgresql" ou "mysql" quando apontar para servidor externo
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Reagent {
  id                 String   @id @default(uuid())
  name               String // Ex: "Ki-67", "CK7", "ER", "Cromógeno DAB"
  manufacturer       String // Ex: "Dako / Agilent", "Roche / Ventana", "Cell Marque"
  cloneOrCode        String? // Ex: "Clone MIB-1 / IR626"
  presentation       String   @default("RTU") // RTU | CONCENTRATED | DETECTION_KIT | BUFFER_REAGENT
  volumeDescription  String // Ex: "Frasco 6 mL RTU" ou "Concentrado 1 mL"
  unit               String   @default("ML") // ML | TESTS | VIAL
  monthlyConsumption Float // Consumo médio estimado por mês
  minStock3Months    Float // Quantidade mínima calculada para 3 meses (monthlyConsumption * 3)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  batches Batch[]
  orders  Order[]

  @@index([name, manufacturer])
  @@map("reagents")
}

model Batch {
  id              String   @id @default(uuid())
  reagentId       String
  lotNumber       String // Número do lote no frasco
  expirationDate  DateTime // Data de validade
  initialQuantity Float
  currentQuantity Float
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  reagent   Reagent    @relation(fields: [reagentId], references: [id], onDelete: Cascade)
  movements Movement[]

  @@unique([reagentId, lotNumber])
  @@index([expirationDate])
  @@map("batches")
}

model Movement {
  id        String   @id @default(uuid())
  batchId   String
  type      String // IN | OUT | EXPIRED_OUT
  quantity  Float
  notes     String? // Ex: "Rotina IHQ 30 lâminas" ou "Entrada NF 1049"
  createdAt DateTime @default(now())

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@map("movements")
}

model Order {
  id                String    @id @default(uuid())
  reagentId         String
  suggestedQuantity Float // (Consumo Médio Mensal * 3) - Estoque Atual
  orderedQuantity   Float // Quantidade efetivamente solicitada
  status            String    @default("PENDING") // PENDING | QUOTED | AWAITING_DELIVERY | RECEIVED | CANCELED
  supplierNotes     String?
  createdAt         DateTime  @default(now())
  receivedAt        DateTime?
  updatedAt         DateTime  @updatedAt

  reagent Reagent @relation(fields: [reagentId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("orders")
}
